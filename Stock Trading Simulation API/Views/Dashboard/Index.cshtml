<h2>Trading Orders Dashboard</h2>

<table border="1" id="ordersTable">
    <thead>
        <tr>
            <th>ID</th>
            <th>Symbol</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Side</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<script>

    async function loadOrders(){

     const response = await fetch('/orders/view/all');
     const orders = await response.json();

     const table = document.querySelector("#ordersTable tbody");

     table.innerHTML="";

     orders.forEach(o => {

      table.innerHTML += `
      <tr>
      <td>${o.id}</td>
      <td>${o.symbol}</td>
      <td>${o.price}</td>
      <td>${o.quantity}</td>
      <td>${o.side}</td>
      </tr>`;
     });

    }

    loadOrders();

    setInterval(loadOrders,2000);

</script>
