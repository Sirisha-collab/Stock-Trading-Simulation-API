@using Stock_Trading_Simulation_API.Domain_Model
@model List<DashboardDTO>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: #0f172a;
        color: #e2e8f0;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 20px 0;
    }

    .title {
        font-size: 28px;
        font-weight: 700;
    }

    .table-container {
        background: #111827;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }

    table {
        color: #e5e7eb !important;
    }

    thead {
        background: #1f2937;
    }

    tbody tr:hover {
        background: #1f2937;
        transition: 0.2s;
    }

    .badge-price {
        font-size: 14px;
        padding: 6px 10px;
        border-radius: 8px;
    }

    .bid {
        background: #16a34a;
        color: white;
    }

    .ask {
        background: #dc2626;
        color: white;
    }

    .btn-modern {
        background: #3b82f6;
        border: none;
        padding: 8px 14px;
        border-radius: 8px;
        color: white;
        font-weight: 500;
        transition: 0.2s;
    }

    .btn-modern:hover {
        background: #2563eb;
    }

    .count-badge {
        background: #334155;
        padding: 6px 10px;
        border-radius: 8px;
    }
</style>

<div class="container">

    <div class="dashboard-header">
        <div class="title">📊 Stock Trading Dashboard</div>

        <button class="btn-modern" onclick="location.reload()">
            🔄 Refresh
        </button>
    </div>

    <div class="table-container">

        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Symbol</th>
                    <th>Best Bid</th>
                    <th>Active Orders</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var stock in Model)
                    {
                        <tr>
                            <td><strong>@stock.Symbol</strong></td>

                            <td>
                                <span class="badge-price bid">
                                    @stock.BestBid
                                </span>
                            </td>
                            <td>
                                <span class="count-badge">
                                    @stock.ActiveOrderCount
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            No market data available
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>